# À copier en .env sur le serveur (lu par docker compose)
DOMAIN=materiel.exemple.fr
DB_NAME=inventaire_physique
# Ne pas utiliser "root" ici : MariaDB refuse de créer cet utilisateur
DB_USER=materiel
DB_PASS=changez-moi
DB_ROOT_PASS=changez-moi-aussi
# Heures (Europe/Paris) de remise à zéro de la base de démonstration (facultatif)
RESET_TIMES=04:00 13:00
